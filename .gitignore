# Persistent runtime data: keep it on the host, not in Git.
/models/
/input/
/output/
/hf-cache/

# Local Omni source checkout/build cache.
/.cache/

# Local Compose configuration may contain host-specific paths.
/.env

# Hugging Face credentials are private.
/hf_token

# Keep the checked-in Manager policy, ignore other per-user UI state.
/user/*
!/user/__manager/
/user/__manager/*
!/user/__manager/config.ini

# IDE noise
/.idea/
