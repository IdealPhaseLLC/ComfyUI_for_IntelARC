# Copy to .env and adjust paths for the host.

COMFYUI_IMAGE=comfyui-intel-arc:omni-b2
OMNI_BASE_IMAGE=llm-scaler-omni:0.2.0-b2-comfyui-bmg
COMFYUI_CONTAINER_NAME=comfyui-omni
COMFYUI_PORT=8188

# Persistent host data.
COMFYUI_MODELS_DIR=./models
COMFYUI_INPUT_DIR=./input
COMFYUI_OUTPUT_DIR=./output
COMFYUI_USER_DIR=./user
COMFYUI_HF_CACHE_DIR=./hf-cache
